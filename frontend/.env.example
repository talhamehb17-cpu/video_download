# Lumora web app configuration. Copy to `.env.local` for local development.
# Only variables prefixed with VITE_ are exposed to the browser, and everything
# here is public by nature: never put a secret in a VITE_ variable.

# Base URL of the Lumora API (no trailing slash), e.g. https://lumora-api.onrender.com
# Leave empty in development: requests go to /api and are proxied to the local API.
VITE_API_BASE_URL=

# Optional: address shown behind the "Contact" links. When empty, Contact opens
# the project's issue tracker instead.
VITE_CONTACT_EMAIL=

# Development only: where the dev server proxies /api to.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
