# Lumora API configuration. Copy to `.env` for local development; on a host, set
# these as environment variables. Every value has a safe default, so an empty
# file works for development. Never commit a real `.env`.

# --- General --------------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
ENABLE_DOCS=true                 # interactive API docs at /docs

# --- Browser access (CORS) --------------------------------------------------------
# Origins of the frontend, comma separated. No trailing slash, no wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regular expression for additional origins (e.g. preview deployments).
ALLOWED_ORIGIN_REGEX=

# --- Finding the real client address behind a proxy --------------------------------
# Used for rate limits. Set ONE of these to match your platform:
#   CLIENT_IP_HEADER    a header your platform always overwrites (e.g. CF-Connecting-IP)
#   TRUSTED_PROXY_HOPS  number of reverse proxies that append to X-Forwarded-For
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0

# --- Which sources are served --------------------------------------------------------
# platforms (default): the platforms that are switched on: the built-in catalog plus
#       websites the administrator added and approved in the admin panel.
# allowlist: only ALLOWED_DOMAINS and their sub-domains; the admin switches have no effect.
# open: any public site the extractor supports, except BLOCKED_DOMAINS and platforms
#       the administrator switched off.
# Whatever the mode, you are responsible for only serving sources that permit downloading.
SOURCE_POLICY=platforms
# ALLOWED_DOMAINS=archive.org,wikimedia.org,media.ccc.de,nasa.gov,blender.org
BLOCKED_DOMAINS=
# --- Age-restricted videos -------------------------------------------------------------------
# An 18+ video (a platform's own age question, or an 18+ label) is offered only after the
# visitor confirms that they are 18 or older. Lumora never signs in and never confirms an age
# itself: the visitor answers, in the browser, and the answer is remembered for
# AGE_CONFIRMATION_TTL_SECONDS on that device.
# false: never offer such a video: do not even ask (the old rule).
BLOCK_AGE_RESTRICTED=false
# false: never ask and never offer an 18+ video. Leave this on unless you must block them.
AGE_CONFIRMATION=true
# How long an answer counts on one device: 21 600 = six hours.
# AGE_CONFIRMATION_TTL_SECONDS=21600
ALLOWED_PORTS=80,443

# "Try an example" links shown on the home page: "Label | Source | URL" entries separated
# by ";". Leave unset for two openly licensed films (Big Buck Bunny on the Internet
# Archive, Sintel on Wikimedia Commons); set it empty to show none. Links that the
# policy above would refuse are never shown.
# EXAMPLE_LINKS=Big Buck Bunny | Internet Archive | https://archive.org/details/BigBuckBunny_124

# --- Limits ----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=1536            # 1.5 GB
MAX_DURATION_SECONDS=14400
MAX_CONCURRENT_JOBS=2            # downloads running at the same time
MAX_QUEUED_JOBS=20
MAX_ACTIVE_JOBS_PER_CLIENT=2
MAX_CONCURRENT_LIGHT_TASKS=4     # analyses / subtitle fetches at the same time
ANALYZE_TIMEOUT_SECONDS=45
SUBTITLE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=1800

# --- Rate limits per client ("N/second|minute|hour") --------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=12/minute
RATE_LIMIT_JOBS=12/minute
RATE_LIMIT_STATUS=600/minute
RATE_LIMIT_FILES=60/minute
RATE_LIMIT_DEFAULT=240/minute

# --- Temporary storage ---------------------------------------------------------------------
# Wiped at start-up and shutdown. Defaults to <system temp>/lumora-media.
# STORAGE_DIR=/var/tmp/lumora-media
FILE_TTL_SECONDS=1800            # finished files are deleted after this long
ANALYSIS_TTL_SECONDS=1800
JOB_RECORD_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=30
MIN_FREE_DISK_MB=1024            # space Lumora never touches: downloads are refused, or stopped, before
                                 # free space would fall below it
STORAGE_BUDGET_MB=0              # most space Lumora may occupy in total; 0 = only the floor above applies

# --- Administrator ---------------------------------------------------------------------------
# The admin panel is off until both values are set. The account is created from them at
# the first start; the password must be replaced at the first sign-in and never works
# again afterwards. Keep real values out of version control.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Where the (hashed) admin password and the platform settings are kept. Must survive
# restarts. Defaults to backend/data.
# DATA_DIR=/var/lib/lumora

# --- Tools ----------------------------------------------------------------------------------
# FFmpeg is found on PATH automatically. Set this only if it lives somewhere else.
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Local testing only ----------------------------------------------------------------------
# Exact IP:port pairs exempt from the public-network rule, for running against
# `scripts/sample_source.py`. Refused when ENVIRONMENT=production.
# UNSAFE_ALLOW_HOSTS=127.0.0.1:8765
# EXAMPLE_LINKS=Sample clip | local sample source | http://127.0.0.1:8765/watch/demo
